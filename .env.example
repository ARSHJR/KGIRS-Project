# Copy this file to .env and fill in real values. Never commit the real .env file.

# Groq API (OpenAI-compatible endpoint) - used for answer generation.
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_BASE=https://api.groq.com/openai/v1

# Optional: Wikidata SPARQL endpoint (default public endpoint used if unset)
WIKIDATA_SPARQL_ENDPOINT=https://query.wikidata.org/sparql
WIKIDATA_API_ENDPOINT=https://www.wikidata.org/w/api.php

# User agent string sent to Wikidata (required by their usage policy)
WIKIDATA_USER_AGENT=CorrectiveRAG-CollegeProject/1.0 (contact: smitha.satpute@wecaredigital.in)
